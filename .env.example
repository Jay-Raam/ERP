# Copy to .env (never commit .env). Values below match docker-compose.yml.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# The web app's origin. Writes from any other origin are refused.
CORS_ORIGINS=http://localhost:3000
# Signs session tokens. At least 32 characters; required in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
DATABASE_URL=postgres://erp:erp_local_only@localhost:5432/erp
# Optional: owner-level login used only by `pnpm db:migrate` when DATABASE_URL is a restricted role.
MIGRATION_DATABASE_URL=
MONGO_URL=mongodb://localhost:27017/erp
REDIS_URL=redis://localhost:6379

# Web. Read when the web app is built or the dev server starts.
API_URL=http://localhost:4000

# Tests only. Must name a database ending in _test; it is wiped on every test run.
# TEST_DATABASE_URL=postgres://erp:erp_local_only@localhost:5432/erp_test
# TEST_REDIS_URL=redis://localhost:6379
